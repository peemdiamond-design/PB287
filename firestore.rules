rules_version = '2';

// Firestore Security Rules สำหรับ PB287 All-Hazards Portal
// Deploy: firebase deploy --only firestore:rules
// หรือคัดลอกไปวางที่ Firebase Console > Firestore Database > Rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // แอดมิน = ผู้ที่มีเอกสาร admins/{uid} (เพิ่มด้วยมือผ่าน Firebase Console เท่านั้น)
    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validLatLng(d) {
      return d.lat is number && d.lng is number
        && d.lat >= -90 && d.lat <= 90
        && d.lng >= -180 && d.lng <= 180;
    }

    // รายชื่อแอดมิน: เจ้าของอ่านของตัวเองได้ เขียนจากหน้าเว็บไม่ได้
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ประกาศแจ้งเตือน: ทุกคนอ่านได้ เฉพาะแอดมินเขียน/ลบ
    match /artifacts/{appId}/public/data/alerts/{alertId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['text', 'severity', 'timestamp'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.severity in ['blue', 'yellow', 'orange', 'red']
        && request.resource.data.timestamp is number;
      allow update, delete: if isAdmin();
    }

    // จุดสิ่งกีดขวาง: ทุกคนอ่านได้ ผู้ใช้ (รวม anonymous) แจ้งได้ แอดมินลบได้
    match /artifacts/{appId}/public/data/obstacles/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['lat', 'lng', 'uid', 'timestamp'])
        && validLatLng(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.timestamp is number;
      allow update, delete: if isAdmin();
    }

    // SOS: มีพิกัด/เบอร์โทรส่วนตัว — แอดมินอ่านทั้งหมด ผู้แจ้งอ่านได้เฉพาะของตัวเอง
    match /artifacts/{appId}/public/data/sos/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['lat', 'lng', 'uid', 'level', 'people', 'phone', 'timestamp'])
        && validLatLng(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.level in ['red', 'yellow', 'green']
        && request.resource.data.people is int
        && request.resource.data.people >= 0 && request.resource.data.people <= 999
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.timestamp is number;
      allow update, delete: if isAdmin();
    }
  }
}
